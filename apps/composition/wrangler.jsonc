{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-vignette-starter",
  "main": "./src/worker.tsx",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__vignette/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COMPOSITION",
        "class_name": "CompositionDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CompositionDurableObject"]
    }
  ]
}
